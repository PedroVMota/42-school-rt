# Graveyard: near-black ambient, one sickly green light low on the horizon,
# a field of cone "tombstones" throwing long shadows across the ground.
C 0,3,14 0,-0.2,-1 55
A 0.03 40,45,40

L -6,1.5,2   0.9 90,140,90
L 8,0.5,-4   0.25 60,60,90

pl 0,-1,0 0,1,0 20,22,20

co -4,-1,-2   0,1,0 0.8 2.4 60,58,54
co -1.5,-1,1  0,1,0 0.7 1.8 55,53,50
co 1.2,-1,-3  0,1,0 0.9 2.8 65,60,56
co 3.5,-1,0.5 0,1,0 0.6 1.5 50,48,46
co 5.5,-1,-2  0,1,0 0.75 2.1 58,55,52

sp 0,-0.4,-6 1.2 15,15,15
